NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://mehwar_app:mehwar_app@localhost:5432/mehwar
WEB_ORIGIN=http://localhost:3000
# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# openssl rand -base64 32   (add new versions to rotate: "1:<old>,2:<new>" and bump the current version)
MASTER_KEYS=1:REPLACE_WITH_BASE64_32_BYTE_KEY
MASTER_KEY_CURRENT_VERSION=1
REFRESH_COOKIE_PATH=/auth
