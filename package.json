{
  "name": "mehwar-flow",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "db:generate": "pnpm --filter @mehwar/db generate",
    "db:migrate": "pnpm --filter @mehwar/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @mehwar/db migrate:dev",
    "db:seed": "pnpm --filter @mehwar/db seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "~5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@swc/core",
      "@nestjs/core",
      "sharp",
      "unrs-resolver"
    ]
  }
}
