// Mehwar Flow data model.
//
// Tenancy: every tenant-owned row carries `organization_id`. In the MVP each user owns exactly one
// personal organization (created at sign-up); teams/roles will add a membership table later
// without migrating existing data. Tenant tables are protected by Postgres Row-Level Security
// (see migrations/*_row_level_security) keyed on the `app.current_org_id` setting.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection: a non-superuser role so RLS is enforced.
  url       = env("DATABASE_URL")
  // Migrations connect as the schema owner.
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  name            String
  timezone        String    @default("UTC")
  /// X Premium subscribers may post up to 25,000 characters.
  xPremium        Boolean   @default(false) @map("x_premium")
  emailVerifiedAt DateTime? @map("email_verified_at")
  /// Brand voice guidance used by the AI assistant.
  brandVoice      String?   @map("brand_voice")
  /// User-level AI provider: nvidia, openai, anthropic, gemini, groq, openrouter, ollama, custom.
  aiProvider      String?   @map("ai_provider")
  aiBaseUrl       String?   @map("ai_base_url")
  aiModel         String?   @map("ai_model")
  aiDefaultModel  String?   @map("ai_default_model")
  aiApiKeyEnc     String?   @map("ai_api_key_enc")
  aiApiKeyPrefix  String?   @map("ai_api_key_prefix")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization?
  sessions     Session[]

  @@map("users")
}

/// Tenant boundary. MVP: one personal organization per user.
model Organization {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  ownerId        String   @unique @map("owner_id") @db.Uuid
  /// Per-organization data encryption key, wrapped by the master key (envelope encryption).
  wrappedDataKey String   @map("wrapped_data_key")
  dataKeyVersion Int      @map("data_key_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  owner         User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  channels      Channel[]
  credentials   ChannelCredential[]
  media         MediaAsset[]
  posts         Post[]
  postTargets   PostTarget[]
  auditLogs     AuditLog[]
  notifications Notification[]
  postingSlots  PostingSlot[]
  metrics       MetricSnapshot[]
  aiUsage       AiUsage[]
  subscription  Subscription?
  customers     Customer[]
  customerGroups CustomerGroup[]
  whatsappSession WhatsappSession?

  @@map("organizations")
}

/// Refresh-token sessions. Only a SHA-256 hash of the token is stored; tokens rotate on every use.
model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  /// All tokens rotated from the same login share a family; reuse of an old token revokes it.
  familyId     String    @map("family_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

enum Platform {
  x
  facebook
  instagram
  threads
  youtube
  tiktok
  snapchat
  linkedin
}

enum ChannelStatus {
  ACTIVE
  NEEDS_RECONNECT
  DISCONNECTED
}

/// A connected social destination (X account, Facebook Page, Instagram business account, ...).
model Channel {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  platform       Platform
  /// The platform's id for the account/page/channel.
  externalId     String        @map("external_id")
  displayName    String        @map("display_name")
  username       String?
  avatarUrl      String?       @map("avatar_url")
  status         ChannelStatus @default(ACTIVE)
  /// Platform-specific extras (e.g. linked Facebook Page id for Instagram).
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credential   ChannelCredential?
  postTargets  PostTarget[]
  metrics      MetricSnapshot[]

  @@unique([organizationId, platform, externalId])
  @@index([organizationId])
  @@map("channels")
}

/// Encrypted OAuth credentials (AES-256-GCM with the organization data key).
model ChannelCredential {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  channelId             String    @unique @map("channel_id") @db.Uuid
  accessTokenEnc        String    @map("access_token_enc")
  refreshTokenEnc       String?   @map("refresh_token_enc")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scopes                String[]
  lastRefreshedAt       DateTime? @map("last_refreshed_at")
  refreshFailures       Int       @default(0) @map("refresh_failures")
  lastError             String?   @map("last_error")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([accessTokenExpiresAt])
  @@map("channel_credentials")
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model MediaAsset {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  /// Object key in the MinIO/S3 bucket, always prefixed with the organization id.
  storageKey      String      @unique @map("storage_key")
  fileName        String      @map("file_name")
  mimeType        String      @map("mime_type")
  sizeBytes       BigInt      @map("size_bytes")
  width           Int?
  height          Int?
  durationSec     Float?      @map("duration_sec")
  thumbnailKey    String?     @map("thumbnail_key")
  /// Publicly readable copy (under `public/`) that pull-based platforms fetch.
  publicKey       String?     @map("public_key")
  processingError String?     @map("processing_error")
  status          MediaStatus @default(UPLOADING)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts        PostMedia[]

  @@index([organizationId, createdAt])
  @@map("media_assets")
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_FAILED
  FAILED
}

model Post {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  /// Base text shared by all networks; per-network overrides live on PostTarget.
  text           String     @default("")
  /// Posted as the first comment where supported (Instagram, Facebook).
  firstComment   String?    @map("first_comment")
  status         PostStatus @default(DRAFT)
  /// UTC instant; `timezone` keeps the zone the user picked the time in.
  scheduledAt    DateTime?  @map("scheduled_at")
  timezone       String     @default("UTC")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targets      PostTarget[]
  media        PostMedia[]

  @@index([organizationId, scheduledAt])
  @@map("posts")
}

enum TargetStatus {
  PENDING
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
}

/// One post delivered to one channel, with its own overrides, status and result.
model PostTarget {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  postId         String       @map("post_id") @db.Uuid
  channelId      String       @map("channel_id") @db.Uuid
  /// Per-network text override (null = use the post text).
  textOverride   String?      @map("text_override")
  /// Platform-specific fields (YouTube title/privacy/madeForKids, TikTok privacy, thread blocks...).
  options        Json         @default("{}")
  status         TargetStatus @default(PENDING)
  scheduledAt    DateTime?    @map("scheduled_at")
  attempts       Int          @default(0)
  externalId     String?      @map("external_id")
  externalUrl    String?      @map("external_url")
  lastError      String?      @map("last_error")
  publishedAt    DateTime?    @map("published_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post         Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  channel      Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  metrics      MetricSnapshot[]

  @@unique([postId, channelId])
  /// Used by the scheduler sweeper to find due targets.
  @@index([status, scheduledAt])
  @@map("post_targets")
}

model PostMedia {
  postId   String @map("post_id") @db.Uuid
  mediaId  String @map("media_id") @db.Uuid
  position Int

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  // Deleting in-use media is blocked by the API; the cascade lets account deletion remove everything.
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([postId, mediaId])
  @@map("post_media")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String
  targetType     String?  @map("target_type")
  targetId       String?  @map("target_id")
  metadata       Json     @default("{}")
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

enum NotificationKind {
  POST_PUBLISHED
  POST_FAILED
  CHANNEL_NEEDS_RECONNECT
  CHANNEL_CONNECTED
  SYSTEM
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  kind           NotificationKind
  title          String
  body           String?
  link           String?
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("notifications")
}

/// Recurring weekly posting times ("queue slots") used by "add to next free slot".
model PostingSlot {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// 0 = Sunday ... 6 = Saturday, in the user's time zone.
  weekday        Int
  /// Minutes after local midnight.
  minuteOfDay    Int      @map("minute_of_day")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, weekday, minuteOfDay])
  @@map("posting_slots")
}

/// Point-in-time engagement numbers for a published post target, or account followers
/// (postTargetId null).
model MetricSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  channelId      String   @map("channel_id") @db.Uuid
  postTargetId   String?  @map("post_target_id") @db.Uuid
  capturedAt     DateTime @default(now()) @map("captured_at")
  impressions    Int      @default(0)
  likes          Int      @default(0)
  comments       Int      @default(0)
  shares         Int      @default(0)
  views          Int      @default(0)
  followers      Int?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  postTarget   PostTarget?  @relation(fields: [postTargetId], references: [id], onDelete: Cascade)

  @@index([organizationId, capturedAt])
  @@index([postTargetId, capturedAt])
  @@map("metric_snapshots")
}

model AiUsage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  feature        String
  inputTokens    Int      @map("input_tokens")
  outputTokens   Int      @map("output_tokens")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("ai_usage")
}

model Subscription {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @unique @map("organization_id") @db.Uuid
  plan                 String    @default("free")
  status               String    @default("active")
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  currentPeriodEnd     DateTime? @map("current_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  mobileNumber   String    @map("mobile_number")
  whatsappNumber String    @map("whatsapp_number")
  email          String?
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groupMembers   CustomerGroupMember[]

  @@index([organizationId, name])
  @@index([organizationId, email])
  @@index([organizationId, mobileNumber])
  @@map("customers")
}

model CustomerGroup {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        CustomerGroupMember[]

  @@index([organizationId, name])
  @@map("customer_groups")
}

model CustomerGroupMember {
  id         String        @id @default(uuid()) @db.Uuid
  groupId    String        @map("group_id") @db.Uuid
  customerId String        @map("customer_id") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at")

  group      CustomerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([groupId, customerId])
  @@index([groupId])
  @@index([customerId])
  @@map("customer_group_members")
}

model WhatsappSession {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @unique @map("organization_id") @db.Uuid
  status         String    @default("DISCONNECTED")
  phoneNumber    String?   @map("phone_number")
  pushname       String?   @map("pushname")
  platform       String?   @default("WhatsApp Web")
  connectedAt    DateTime? @map("connected_at")
  disconnectedAt DateTime? @map("disconnected_at")
  metadata       Json?     @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("whatsapp_sessions")
}

