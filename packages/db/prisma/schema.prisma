// Mehwar Flow data model.
//
// Tenancy: every tenant-owned row carries `organization_id`. In the MVP each user owns exactly one
// personal organization (created at sign-up); teams/roles will add a membership table later
// without migrating existing data. Tenant tables are protected by Postgres Row-Level Security
// (see migrations/*_row_level_security) keyed on the `app.current_org_id` setting.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection: a non-superuser role so RLS is enforced.
  url       = env("DATABASE_URL")
  // Migrations connect as the schema owner.
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  timezone     String    @default("UTC")
  /// X Premium subscribers may post up to 25,000 characters.
  xPremium     Boolean   @default(false) @map("x_premium")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  organization Organization?
  sessions     Session[]

  @@map("users")
}

/// Tenant boundary. MVP: one personal organization per user.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String   @unique @map("owner_id") @db.Uuid
  /// Per-organization data encryption key, wrapped by the master key (envelope encryption).
  wrappedDataKey  String @map("wrapped_data_key")
  dataKeyVersion  Int    @map("data_key_version")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner       User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  channels    Channel[]
  credentials ChannelCredential[]
  media       MediaAsset[]
  posts       Post[]
  postTargets PostTarget[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

/// Refresh-token sessions. Only a SHA-256 hash of the token is stored; tokens rotate on every use.
model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  /// All tokens rotated from the same login share a family; reuse of an old token revokes it.
  familyId    String    @map("family_id") @db.Uuid
  userAgent   String?   @map("user_agent")
  ip          String?
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  replacedById String?  @map("replaced_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

enum Platform {
  x
  facebook
  instagram
  threads
  youtube
  tiktok
  snapchat
}

enum ChannelStatus {
  ACTIVE
  NEEDS_RECONNECT
  DISCONNECTED
}

/// A connected social destination (X account, Facebook Page, Instagram business account, ...).
model Channel {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  platform       Platform
  /// The platform's id for the account/page/channel.
  externalId     String        @map("external_id")
  displayName    String        @map("display_name")
  username       String?
  avatarUrl      String?       @map("avatar_url")
  status         ChannelStatus @default(ACTIVE)
  /// Platform-specific extras (e.g. linked Facebook Page id for Instagram).
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credential   ChannelCredential?
  postTargets  PostTarget[]

  @@unique([organizationId, platform, externalId])
  @@index([organizationId])
  @@map("channels")
}

/// Encrypted OAuth credentials (AES-256-GCM with the organization data key).
model ChannelCredential {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  channelId             String    @unique @map("channel_id") @db.Uuid
  accessTokenEnc        String    @map("access_token_enc")
  refreshTokenEnc       String?   @map("refresh_token_enc")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scopes                String[]
  lastRefreshedAt       DateTime? @map("last_refreshed_at")
  refreshFailures       Int       @default(0) @map("refresh_failures")
  lastError             String?   @map("last_error")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([accessTokenExpiresAt])
  @@map("channel_credentials")
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model MediaAsset {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  /// Object key in the MinIO/S3 bucket, always prefixed with the organization id.
  storageKey     String      @unique @map("storage_key")
  fileName       String      @map("file_name")
  mimeType       String      @map("mime_type")
  sizeBytes      BigInt      @map("size_bytes")
  width          Int?
  height         Int?
  durationSec    Float?      @map("duration_sec")
  thumbnailKey   String?     @map("thumbnail_key")
  status         MediaStatus @default(UPLOADING)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts        PostMedia[]

  @@index([organizationId, createdAt])
  @@map("media_assets")
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_FAILED
  FAILED
}

model Post {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  /// Base text shared by all networks; per-network overrides live on PostTarget.
  text           String     @default("")
  status         PostStatus @default(DRAFT)
  /// UTC instant; `timezone` keeps the zone the user picked the time in.
  scheduledAt    DateTime?  @map("scheduled_at")
  timezone       String     @default("UTC")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targets      PostTarget[]
  media        PostMedia[]

  @@index([organizationId, scheduledAt])
  @@map("posts")
}

enum TargetStatus {
  PENDING
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
}

/// One post delivered to one channel, with its own overrides, status and result.
model PostTarget {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  postId         String       @map("post_id") @db.Uuid
  channelId      String       @map("channel_id") @db.Uuid
  /// Per-network text override (null = use the post text).
  textOverride   String?      @map("text_override")
  /// Platform-specific fields (YouTube title/privacy/madeForKids, TikTok privacy, thread blocks...).
  options        Json         @default("{}")
  status         TargetStatus @default(PENDING)
  scheduledAt    DateTime?    @map("scheduled_at")
  attempts       Int          @default(0)
  externalId     String?      @map("external_id")
  externalUrl    String?      @map("external_url")
  lastError      String?      @map("last_error")
  publishedAt    DateTime?    @map("published_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post         Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([postId, channelId])
  /// Used by the scheduler sweeper to find due targets.
  @@index([status, scheduledAt])
  @@map("post_targets")
}

model PostMedia {
  postId   String @map("post_id") @db.Uuid
  mediaId  String @map("media_id") @db.Uuid
  position Int

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([postId, mediaId])
  @@map("post_media")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String
  targetType     String?  @map("target_type")
  targetId       String?  @map("target_id")
  metadata       Json     @default("{}")
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
